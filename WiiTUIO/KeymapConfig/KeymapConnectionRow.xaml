<UserControl x:Class="WiiTUIO.KeymapConnectionRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="415">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="./CustomStyleNumericUpDown.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.FlatButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <Rectangle Width="200" Height="6" Fill="#FFEEEEEE"></Rectangle>
        <Grid Name="buttonBlup" Visibility="Collapsed">
            <Ellipse Width="18" Height="18" Margin="0,0,70,0" Fill="#FFEEEEEE"></Ellipse>
        </Grid>
        <Grid Name="stickBlup" Visibility="Collapsed">
            <Ellipse Width="18" Height="18" Margin="0,0,70,0" Fill="#FFEEEEEE"></Ellipse>
            <Ellipse Width="12" Height="12" Margin="0,0,70,0" Fill="White"></Ellipse>
            <Ellipse Width="8" Height="8" Margin="0,0,70,0" Fill="#FFEEEEEE"></Ellipse>
        </Grid>
        <Grid Name="cursorBlup" Visibility="Collapsed">
            <Rectangle Width="4" Height="28" Margin="0,0,70,0" Fill="#FFEEEEEE"></Rectangle>
            <Ellipse Width="18" Height="18" Margin="0,0,70,0" Fill="#FFEEEEEE"></Ellipse>
            <Ellipse Width="12" Height="12" Margin="0,0,70,0" Fill="White"></Ellipse>
        </Grid>
        <Border Name="connection_input_border" Background="#FFEEEEEE" BorderThickness="0" BorderBrush="White" Margin="5,5,265,5" CornerRadius="2">
        </Border>
        <StackPanel Margin="5,5,265,5" VerticalAlignment="Center">
            <Grid>
                <TextBlock Name="connection_input_name" Text="Default" Margin="5" FontSize="14" FontFamily="Segoe UI Semilight" Foreground="Black" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Name="connection_input_config_openbutton" Cursor="Hand" PreviewMouseUp="connection_input_config_openbutton_MouseUp"  Width="24" Height="24" Margin="0,3,2,0" VerticalAlignment="Top" HorizontalAlignment="Right" 
                        Content="{iconPacks:Material Kind=Cog, Width=12, Height=12}" Padding="0,0,0,0" Foreground="#FFACACAC" Background="Transparent" />
                <Button Name="connection_input_config_closebutton" Cursor="Hand" PreviewMouseUp="connection_input_config_closebutton_MouseUp"  Width="24" Height="24" Margin="0,3,2,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Content="{iconPacks:Material Kind=CheckBold, Width=12, Height=12}" Padding="0,0,0,0" Foreground="Gray" Background="Transparent" />
            </Grid>
            <Border Name="connection_input_config_border" Background="#FFFFFFFF" BorderThickness="0" BorderBrush="White" Margin="5,5,5,5" CornerRadius="2">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Deadzone" Margin="5,5,72,5" FontSize="11" FontFamily="Segoe UI Semilight" Foreground="Black" TextAlignment="Right" VerticalAlignment="Center" />
                        <Controls:NumericUpDown Name="deadzone_updown"
                                                StringFormat="F2"
                                                Value="0.01"
                                                Interval="0.1"
                                                Maximum="1.0"
                                                Margin="34,0,5,0"
                                                FontFamily="Segoe UI Semilight"
                                                FontSize="12"
                                                Minimum="0"
                                                BorderBrush="#FFDEDEDE"
                                                Height="18"
                                                Width="62"
                                                UpDownButtonsWidth="14"
                                                Padding="0"
                                                HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Scale" Margin="5,5,72,5" FontSize="11" FontFamily="Segoe UI Semilight" Foreground="Black" TextAlignment="Right" VerticalAlignment="Center" />
                        <Controls:NumericUpDown Name="scale_updown"
                                                StringFormat="F2"
                                                Value="1.0"
                                                Interval="0.1"
                                                Maximum="10.0"
                                                Margin="34,0,5,0"
                                                FontFamily="Segoe UI Semilight"
                                                FontSize="12"
                                                Minimum="0"
                                                BorderBrush="#FFDEDEDE"
                                                Height="18"
                                                Width="62"
                                                UpDownButtonsWidth="14"
                                                Padding="0"
                                                HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Threshold" Margin="5,5,72,5" FontSize="11" FontFamily="Segoe UI Semilight" Foreground="Black" TextAlignment="Right" VerticalAlignment="Center" />
                        <Controls:NumericUpDown Name="threshold_updown"
                                                StringFormat="F2"
                                                Value="0.8"
                                                Interval="0.1"
                                                Maximum="1.0"
                                                Margin="34,0,5,0"
                                                FontFamily="Segoe UI Semilight"
                                                FontSize="12"
                                                Minimum="0"
                                                BorderBrush="#FFDEDEDE"
                                                Height="18"
                                                Width="62"
                                                UpDownButtonsWidth="14"
                                                Padding="0"
                                                HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Background="White" Margin="196,5,70,5"></Border>
        <Grid Margin="196,0,0,0" VerticalAlignment="Center">
            <StackPanel Margin="0,5,70,5" Name="connection_output_stack" MinHeight="30" Width="140" VerticalAlignment="Bottom" HorizontalAlignment="Left">

            </StackPanel>
            <!--Border Name="connection_output_border" Background="Black" BorderThickness="0" BorderBrush="#F20A0A0A" Margin="226,5,40,5" AllowDrop="True" Drop="connection_output_border_Drop" DragEnter="connection_output_border_DragEnter" DragLeave="connection_output_border_DragLeave" CornerRadius="2">
            <TextBlock Name="connection_output_name" Text="Default" Margin="5" FontSize="14" FontFamily="Segoe UI Semilight" Foreground="White" TextAlignment="Center" />
        </Border-->

            <!--Rectangle Width="30" Height="30" StrokeThickness="3" RadiusY="2" RadiusX="2" Stroke="Gray" Margin="360,0,0,0" /-->
            <Button Name="rAdd" Cursor="Hand" PreviewMouseUp="rAdd_MouseUp"  Width="24" Height="24" Margin="0,0,33,8" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Content="{iconPacks:Material Kind=Plus, Width=14, Height=14}" Padding="0,0,0,0" Foreground="Gray" Background="Transparent" />
            <Button Name="rClear" Cursor="Hand" PreviewMouseUp="rClear_MouseUp"  Width="24" Height="24" Margin="0,0,4,8" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Content="{iconPacks:Material Kind=CloseThick, Width=11, Height=11}" Padding="0,0,0,0" Foreground="Gray" Background="Transparent" />
        </Grid>
    </Grid>
</UserControl>
